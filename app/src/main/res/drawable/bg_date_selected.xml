<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40FFFFFF">
    <item>
        <layer-list>
            <item android:bottom="35dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF"/>
                    <corners android:topLeftRadius="12dp" android:topRightRadius="12dp"/>
                    <stroke android:width="1dp" android:color="#E0E0E0" />
                </shape>
            </item>
            <item android:top="30dp">
                <shape android:shape="rectangle">
                    <solid android:color="#D81B60"/>
                    <corners android:bottomLeftRadius="12dp" android:bottomRightRadius="12dp"/>
                    <stroke android:width="1dp" android:color="#D81B60" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>