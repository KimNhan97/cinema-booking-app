<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F8EDED"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chỉnh sửa thông tin phim"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tên phim" android:textStyle="bold" android:textColor="#475569" android:textSize="13sp"/>
        <EditText
            android:id="@+id/dialogEdtTitle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:color/white"
            android:padding="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:inputType="text"
            android:textSize="14sp"
            android:textColor="#1E293B"/> <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thời lượng (phút)" android:textStyle="bold" android:textColor="#475569" android:textSize="13sp"/>
        <EditText
            android:id="@+id/dialogEdtDuration"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:color/white"
            android:padding="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:inputType="number"
            android:textSize="14sp"
            android:textColor="#1E293B"/> <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thể loại" android:textStyle="bold" android:textColor="#475569" android:textSize="13sp"/>
        <EditText
            android:id="@+id/dialogEdtGenre"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:color/white"
            android:padding="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:inputType="text"
            android:textSize="14sp"
            android:textColor="#1E293B"/> <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ngày phát hành (YYYY-MM-DD)" android:textStyle="bold" android:textColor="#475569" android:textSize="13sp"/>
        <EditText
            android:id="@+id/dialogEdtReleaseDate"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:color/white"
            android:padding="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:inputType="date"
            android:textSize="14sp"
            android:textColor="#1E293B"/> <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trạng thái phim" android:textStyle="bold" android:textColor="#475569" android:textSize="13sp"/>
        <RadioGroup
            android:id="@+id/dialogRadioGroupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/radioNowShowing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang chiếu"
                android:textSize="14sp"
                android:textColor="#1E293B"
                android:layout_marginEnd="16dp"/>

            <RadioButton
                android:id="@+id/radioSoonShowing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sắp chiếu"
                android:textSize="14sp"
                android:textColor="#1E293B"/>
        </RadioGroup>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Poster URL" android:textStyle="bold" android:textColor="#475569" android:textSize="13sp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/dialogEdtPosterUrl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/white"
                android:padding="8dp"
                android:inputType="textUri"
                android:textSize="14sp"
                android:textColor="#1E293B"/> <Button
            android:id="@+id/dialogBtnSubmitPoster"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:text="Nộp"
            android:textSize="12sp"
            android:backgroundTint="#B8004A"
            android:textColor="@android:color/white"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Banner URL" android:textStyle="bold" android:textColor="#475569" android:textSize="13sp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/dialogEdtBannerUrl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/white"
                android:padding="8dp"
                android:inputType="textUri"
                android:textSize="14sp"
                android:textColor="#1E293B"/> <Button
            android:id="@+id/dialogBtnSubmitBanner"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:text="Nộp"
            android:textSize="12sp"
            android:backgroundTint="#B8004A"
            android:textColor="@android:color/white"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mô tả nội dung phim"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/dialogEdtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:gravity="top"
            android:background="@android:color/white"
            android:padding="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:inputType="textMultiLine"
            android:textSize="14sp"
            android:textColor="#1E293B"/> <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/dialogBtnCancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="HỦY BỎ"
            android:backgroundTint="#64748B"
            android:textColor="@android:color/white"
            android:layout_marginEnd="12dp"/>

        <Button
            android:id="@+id/dialogBtnSave"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="XÁC NHẬN"
            android:backgroundTint="#B8004A"
            android:textColor="@android:color/white"/>
    </LinearLayout>

    </LinearLayout>
</ScrollView>