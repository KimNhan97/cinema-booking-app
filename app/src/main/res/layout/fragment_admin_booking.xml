<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <RelativeLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFEBF1"
        android:paddingHorizontal="16dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="QUẢN LÝ VÉ "
            android:textColor="#E91E63"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layoutTopContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutHeader"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@android:drawable/toast_frame"
                android:backgroundTint="#D8DBF0"
                android:orientation="vertical"
                android:padding="12dp">
                <View
                    android:layout_width="16dp"
                    android:layout_height="4dp"
                    android:background="#3F51B5" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ĐÃ ĐẶT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#757575"
                    android:layout_marginTop="6dp"/>
                <TextView
                    android:id="@+id/tvCountBooked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#212121" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="@android:drawable/toast_frame"
                android:backgroundTint="#C3FAC5"
                android:orientation="vertical"
                android:padding="12dp">
                <View
                    android:layout_width="16dp"
                    android:layout_height="4dp"
                    android:background="#4CAF50" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHECK-IN"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#757575"
                    android:layout_marginTop="6dp"/>
                <TextView
                    android:id="@+id/tvCountCheckedIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#212121" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@android:drawable/toast_frame"
                android:backgroundTint="#FBD2D2"
                android:orientation="vertical"
                android:padding="12dp">
                <View
                    android:layout_width="16dp"
                    android:layout_height="4dp"
                    android:background="#B71C1C" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ĐÃ HỦY"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#757575"
                    android:layout_marginTop="6dp"/>
                <TextView
                    android:id="@+id/tvCountCancelled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#212121" />
            </LinearLayout>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="46dp"
            app:cardCornerRadius="23dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#757575" />

                <EditText
                    android:id="@+id/edtSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Tìm kiếm theo mã vé hoặc tên phim..."
                    android:textColorHint="#9E9E9E"
                    android:textColor="#090909"
                    android:textSize="14sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp"
                    android:inputType="text" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <HorizontalScrollView
            android:id="@+id/horizontalTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="10dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/tabAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tất cả"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:background="@android:drawable/toast_frame"
                    android:backgroundTint="#A62B2B"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tabBooked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đã đặt"
                    android:textColor="#424242"
                    android:textSize="14sp"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:background="@android:drawable/btn_default"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tabCheckIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Check-in"
                    android:textColor="#424242"
                    android:textSize="14sp"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:background="@android:drawable/btn_default"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tabCancelled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đã hủy"
                    android:textColor="#424242"
                    android:textSize="14sp"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:background="@android:drawable/btn_default"
                    android:backgroundTint="#FFFFFF"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBookings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutTopContent"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        android:scrollbars="vertical"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnScanQR"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="20dp"
        android:backgroundTint="#E91E63"
        app:tint="#FFFFFF"
        android:src="@android:drawable/ic_menu_camera"
        app:fabSize="normal"
        app:elevation="6dp"
        android:contentDescription="Scan QR Button" />
</RelativeLayout>