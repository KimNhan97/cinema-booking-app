<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CHỈNH SỬA THÔNG TIN"
        android:textColor="#B8004A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:letterSpacing="0.05"/>

    <FrameLayout
        android:id="@+id/dialogLayoutAvatar"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:focusable="true">

        <androidx.cardview.widget.CardView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            app:cardCornerRadius="44dp"
            app:cardElevation="3dp">

            <ImageView
                android:id="@+id/dialogImgAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/sym_def_app_icon" />
        </androidx.cardview.widget.CardView>

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@android:drawable/ic_menu_camera"
            android:layout_gravity="bottom|end"
            app:tint="#FFFFFF"
            android:background="@drawable/bg_input_edit_profile"
            android:backgroundTint="#B8004A"
            android:padding="4dp"/>
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Địa chỉ Email"
        android:textSize="13sp"
        android:textColor="#4A5568"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/dialogEdtEmail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:enabled="false"
        android:hint="Email tài khoản"
        android:textColor="#A0AEC0"
        android:textColorHint="#CBD5E0"
        android:textSize="14sp"
        android:background="@drawable/bg_input_edit_profile"
        android:backgroundTint="#EDF2F7"
        android:layout_marginBottom="16dp"
        android:paddingHorizontal="16dp"
        android:inputType="textEmailAddress"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Họ và Tên"
        android:textSize="13sp"
        android:textColor="#4A5568"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/dialogEdtFullName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Nhập họ và tên đầy đủ của bạn"
        android:textColor="#1A202C"
        android:textColorHint="#A0AEC0"
        android:textSize="14sp"
        android:background="@drawable/bg_input_edit_profile"
        android:layout_marginBottom="16dp"
        android:paddingHorizontal="16dp"
        android:inputType="textPersonName"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Số Điện Thoại"
        android:textSize="13sp"
        android:textColor="#4A5568"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/dialogEdtPhone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Nhập số điện thoại liên lạc"
        android:textColor="#1A202C"
        android:textColorHint="#A0AEC0"
        android:textSize="14sp"
        android:background="@drawable/bg_input_edit_profile"
        android:layout_marginBottom="28dp"
        android:paddingHorizontal="16dp"
        android:inputType="phone"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/dialogBtnCancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HỦY BỎ"
            android:textColor="#718096"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="12dp"
            android:layout_height="match_parent"/>

        <Button
            android:id="@+id/dialogBtnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LƯU LẠI"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B8004A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingHorizontal="20dp"
            app:cornerRadius="8dp"/>
    </LinearLayout>
</LinearLayout>