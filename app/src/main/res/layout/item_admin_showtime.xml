<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/txtMovieName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/txtStatusBadge"
                android:text="Tên Bộ Phim Chiếu"
                android:textColor="#1A202C"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="OPEN"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="#2F855A"
                android:background="@android:color/holo_green_light" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/txtRoomName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phòng: Phòng 1"
                android:textColor="#4A5568"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/txtShowDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ngày chiếu: 2026-05-31"
                android:textColor="#4A5568"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/txtShowTimeRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thời gian: 18:00 - 20:02"
                android:textColor="#4A5568"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GHẾ TRỐNG"
                    android:textColor="#718096"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/txtSeatRatio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="1 / 3"
                    android:textColor="#2D3748"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </RelativeLayout>
            <ProgressBar
                android:id="@+id/progressSeats"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:progress="33" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:weightSum="3">

            <Button
                android:id="@+id/btnEditShowtime"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="✏️ Sửa"
                android:textSize="13sp"
                android:textColor="#4A5568"
                android:layout_marginEnd="4dp"
                android:background="@android:color/transparent"/>

            <Button
                android:id="@+id/btnDeleteShowtime"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="🗑️ Xóa"
                android:textSize="13sp"
                android:textColor="#E53E3E"
                android:layout_marginEnd="4dp"
                android:background="@android:color/transparent"/>

            <Button
                android:id="@+id/btnViewSeats"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="🪑 Ghế"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="#2B6CB0"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>