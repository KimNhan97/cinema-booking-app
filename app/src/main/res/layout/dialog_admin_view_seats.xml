<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/txtSeatDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trạng Thái Ghế Ngồi"
        android:textColor="#1A202C"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:gravity="center"/>

    <ProgressBar
        android:id="@+id/pbSeatsLoading"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:layout_margin="10dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🟢 GHẾ CÒN TRỐNG:"
        android:textStyle="bold"
        android:textColor="#2F855A"
        android:textSize="13sp"/>
    <TextView
        android:id="@+id/txtAvailableSeatsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A2, B1, B3..."
        android:textColor="#2D3748"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔴 GHẾ ĐÃ ĐẶT:"
        android:textStyle="bold"
        android:textColor="#C53030"
        android:textSize="13sp"/>
    <TextView
        android:id="@+id/txtBookedSeatsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A1"
        android:textColor="#2D3748"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnFormatDialogClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ĐÓNG HỘP THOẠI"
        android:backgroundTint="#4A5568"
        android:textColor="#FFFFFF"/>
</LinearLayout>